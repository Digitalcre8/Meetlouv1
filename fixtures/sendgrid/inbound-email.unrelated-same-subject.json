{
  "description": "A different conversation with the same subject line as client-first. Must NOT thread with it.",
  "request": {
    "method": "POST",
    "path": "/{{inboundKeyId}}/{{inboundSecret}}",
    "fields": {
      "envelope": "{\"to\":[\"{{slug}}@{{mailDomain}}\"],\"from\":\"stranger@example.org\"}",
      "SPF": "pass",
      "dkim": "{@example.org : pass}",
      "sender_ip": "198.51.100.7",
      "spam_score": "0.1",
      "charsets": "{\"to\":\"UTF-8\",\"subject\":\"UTF-8\",\"from\":\"UTF-8\"}"
    },
    "emailFile": "messages/unrelated-same-subject.eml"
  }
}
