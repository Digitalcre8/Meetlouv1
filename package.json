{
  "name": "meetlou",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "pnpm -r test",
    "guards": "bash scripts/check-guards.sh",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm guards",
    "db:up": "bash scripts/db-up.sh",
    "db:test": "pnpm --filter @meetlou/db-tests test:db",
    "seed": "pnpm --filter @meetlou/harness seed",
    "harness": "pnpm --silent --filter @meetlou/harness harness",
    "functions:serve": "pnpm --silent --filter @meetlou/harness harness serve",
    "deno:check": "bash scripts/deno-check.sh",
    "eval": "pnpm --silent --filter @meetlou/harness harness eval",
    "timeline:demo": "pnpm --silent --filter @meetlou/harness harness timeline-demo",
    "retention:run": "pnpm --silent --filter @meetlou/retention job"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
