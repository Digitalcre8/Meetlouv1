# Names only. Real values live in the host's secret store, never in git.
# Server-side only (Edge Functions / harness). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Retention job only (a scheduler, never a web route). A JWT whose role claim is retention_runner.
RETENTION_JWT=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=
# Summariser (process-recordings function). Set ANTHROPIC_MODEL to override the default.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
TRANSCRIBER=
SUMMARISER=
# Browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
